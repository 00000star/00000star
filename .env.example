# PostgreSQL (required for accounts, onboarding sync, payment orders)
DATABASE_URL=postgres://nhaka:nhaka_dev@localhost:5432/nhaka

# Session signing — min 32 chars (e.g. openssl rand -hex 32)
AUTH_SECRET=

# Paynow (server-only — never expose the key to the browser)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Optional overrides (defaults match src/lib/payments.ts MERCHANT_CONFIG)
# PAYNOW_RESULT_URL=https://nhaka.co.zw/api/paynow/result
# PAYNOW_RETURN_URL=https://nhaka.co.zw/pay/success
